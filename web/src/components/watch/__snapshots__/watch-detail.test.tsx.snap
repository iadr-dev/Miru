exports[`WatchDetail > says when the stock has not been checked intraday and omits guards 1`] = `"<div class="space-y-4 p-4"><header class="flex items-start justify-between gap-3"><div><h3 class="font-semibold text-[15px] text-[var(--text)]">台積電 <span class="font-normal font-num text-[13px] text-[var(--text-muted)]">2330</span></h3><p class="text-[12px] text-[var(--text-muted)]"><span class="mr-1.5 inline-flex items-center gap-1 rounded-[var(--radius-pill)] px-2 py-0.5 font-medium text-[var(--text)]" style="background-color: color-mix(in srgb, var(--chart-1) 18%, transparent);"><span aria-hidden="true" class="size-2 rounded-full" style="background-color: var(--chart-1);"></span>波動率擠壓</span>已在清單 2 個交易日</p></div><a href="/stock/2330" class="inline-flex min-h-11 items-center gap-1 text-[12.5px] text-[var(--accent-text)] hover:underline">開啟個股頁<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M224,104a8,8,0,0,1-16,0V59.32l-66.33,66.34a8,8,0,0,1-11.32-11.32L196.68,48H152a8,8,0,0,1,0-16h64a8,8,0,0,1,8,8Zm-40,24a8,8,0,0,0-8,8v72H48V80h72a8,8,0,0,0,0-16H48A16,16,0,0,0,32,80V208a16,16,0,0,0,16,16H176a16,16,0,0,0,16-16V136A8,8,0,0,0,184,128Z"></path></svg></a></header><div class="h-40 animate-pulse rounded-[var(--radius-input)] bg-[var(--surface-2)]" aria-hidden="true"></div><section aria-labelledby="watch-triggers"><h4 id="watch-triggers" class="mb-1.5 font-medium text-[12.5px] text-[var(--text)]">觸發條件</h4><p class="text-[12.5px] text-[var(--text-muted)]">盤中尚未檢查這檔股票。</p></section></div>"`;

