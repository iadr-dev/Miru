exports[`ScheduleForm rendering > a single-target template has no scope choice and a single-code label 1`] = `"<div><ul class="divide-y divide-[var(--border)]"></ul><div class="mt-4"><form aria-label="新增排程" class="space-y-4 rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface-2)] p-4"><fieldset class="grid gap-3 sm:grid-cols-2"><div><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="schedule-template">簡報種類</label><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="schedule-template"><option value="tw_stock_report">台股個股完整分析報告</option><option value="us_stock_report">美股個股完整分析報告</option><option value="tw_etf_report">台股 ETF 完整分析報告</option><option value="us_etf_report">美股 ETF 完整分析報告</option><option value="pre_open_brief">盤前快訊</option><option value="after_close_chip">收盤後籌碼檢視</option><option value="disposition_watch">注意股／處置股檢查</option><option value="weekly_catalyst">每週催化事件掃描</option><option value="weekly_watchlist_review">每週自選股回顧</option></select><p class="mt-1 text-[12px] text-[var(--text-muted)]">每個台股交易日收盤後</p></div><div><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="schedule-targets">股票或 ETF 代號</label><input class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] placeholder:text-[var(--text-muted)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="schedule-targets" placeholder="2330" aria-invalid="false" value=""></div></fieldset><p class="text-[12px] text-[var(--text-muted)]">每次執行時才產生內容，並累積在同一個對話中，會計入你的對話額度。</p><div class="flex justify-end gap-2"><button type="button" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-transparent text-[var(--text)] hover:bg-[var(--surface-2)] min-h-11 px-4 text-sm">取消</button><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-[var(--accent)] text-[var(--on-accent)] hover:opacity-90 font-medium min-h-11 px-4 text-sm">建立排程</button></div></form></div></div>"`;

