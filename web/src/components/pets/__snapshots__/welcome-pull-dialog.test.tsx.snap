exports[`WelcomePullDialog > offers the free pull as an intro dialog 1`] = `"<div class="fixed inset-0 z-50 flex items-center justify-center p-4"><button type="button" aria-label="稍後再說" class="absolute inset-0 bg-black/60" tabindex="-1"></button><div role="dialog" aria-modal="true" aria-labelledby="welcome-pull-title" class="relative w-full max-w-sm rounded-[var(--radius-card)] border border-[var(--border)] bg-[var(--surface)] p-6 text-center shadow-2xl"><span class="mx-auto flex size-16 items-center justify-center rounded-full border-2 border-[var(--border)] bg-[var(--surface-2)]"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M212,80a28,28,0,1,0,28,28A28,28,0,0,0,212,80Zm0,40a12,12,0,1,1,12-12A12,12,0,0,1,212,120ZM72,108a28,28,0,1,0-28,28A28,28,0,0,0,72,108ZM44,120a12,12,0,1,1,12-12A12,12,0,0,1,44,120ZM92,88A28,28,0,1,0,64,60,28,28,0,0,0,92,88Zm0-40A12,12,0,1,1,80,60,12,12,0,0,1,92,48Zm72,40a28,28,0,1,0-28-28A28,28,0,0,0,164,88Zm0-40a12,12,0,1,1-12,12A12,12,0,0,1,164,48Zm23.12,100.86a35.3,35.3,0,0,1-16.87-21.14,44,44,0,0,0-84.5,0A35.25,35.25,0,0,1,69,148.82,40,40,0,0,0,88,224a39.48,39.48,0,0,0,15.52-3.13,64.09,64.09,0,0,1,48.87,0,40,40,0,0,0,34.73-72ZM168,208a24,24,0,0,1-9.45-1.93,80.14,80.14,0,0,0-61.19,0,24,24,0,0,1-20.71-43.26,51.22,51.22,0,0,0,24.46-30.67,28,28,0,0,1,53.78,0,51.27,51.27,0,0,0,24.53,30.71A24,24,0,0,1,168,208Z"></path></svg></span><h2 id="welcome-pull-title" class="mt-4 font-semibold text-[var(--text)] text-lg">認識你的第一位夥伴</h2><p class="mt-2 text-[var(--text-muted)] text-sm">你有一次免費抽取。抽出一位陪你聊天的夥伴，純粹好玩，不會改變分析結果，也不影響任何額度。</p><div class="mt-5 flex justify-center gap-2"><button type="button" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-transparent text-[var(--text)] hover:bg-[var(--surface-2)] min-h-11 px-4 text-sm">稍後再說</button><button type="button" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-[var(--accent)] text-[var(--on-accent)] hover:opacity-90 font-medium min-h-11 px-4 text-sm">抽取</button></div></div></div>"`;

