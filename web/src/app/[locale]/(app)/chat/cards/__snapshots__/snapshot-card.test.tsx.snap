exports[`SnapshotCard header > titles the card by symbol, else stock_id, else the card type label 1`] = `"<div class="surface-card mt-3 p-4 sm:p-5"><div class="mb-3 flex items-baseline justify-between gap-3"><span class="font-medium text-[13px] text-[var(--text-muted)]">股價報價</span><span class="text-[11px] text-[var(--text-muted)]">股價報價</span></div><div class="grid grid-cols-2 gap-3 sm:grid-cols-3"><div class="min-w-0"><p class="truncate text-[11px] text-[var(--text-muted)]">收盤價</p><p class="font-num text-[14px] text-[var(--text)] tabular-nums">1</p></div></div></div>"`;

exports[`SnapshotCard stat grid > lists unavailable fields as chips, ignoring non-string entries 1`] = `"<div class="surface-card mt-3 p-4 sm:p-5"><div class="mb-3 flex items-baseline justify-between gap-3"><span class="font-medium text-[13px] text-[var(--text-muted)]">2330</span><span class="text-[11px] text-[var(--text-muted)]">公司概況</span></div><div class="grid grid-cols-2 gap-3 sm:grid-cols-3"><div class="min-w-0"><p class="truncate text-[11px] text-[var(--text-muted)]">細分產業</p><p class="truncate text-[14px] text-[var(--text)]">半導體</p></div></div><div class="mt-3 flex flex-wrap gap-1.5"><span class="rounded-[var(--radius-pill)] bg-[var(--surface-2)] px-2 py-0.5 text-[11px] text-[var(--text-muted)]">EPS 暫無資料</span><span class="rounded-[var(--radius-pill)] bg-[var(--surface-2)] px-2 py-0.5 text-[11px] text-[var(--text-muted)]">市值 暫無資料</span></div></div>"`;

exports[`SnapshotCard stat grid > renders strings, numbers and booleans, in order, and drops everything else 1`] = `"<div class="surface-card mt-3 p-4 sm:p-5"><div class="mb-3 flex items-baseline justify-between gap-3"><span class="font-medium text-[13px] text-[var(--text-muted)]">2330</span><span class="text-[11px] text-[var(--text-muted)]">公司概況</span></div><div class="grid grid-cols-2 gap-3 sm:grid-cols-3"><div class="min-w-0"><p class="truncate text-[11px] text-[var(--text-muted)]">細分產業</p><p class="truncate text-[14px] text-[var(--text)]">半導體</p></div><div class="min-w-0"><p class="truncate text-[11px] text-[var(--text-muted)]">Employees</p><p class="font-num text-[14px] text-[var(--text)] tabular-nums">1,234.5</p></div><div class="min-w-0"><p class="truncate text-[11px] text-[var(--text-muted)]">Listed</p><p class="truncate text-[14px] text-[var(--text)]">true</p></div></div></div>"`;

exports[`SnapshotCard stat grid > shows large monetary fields compactly with the full figure as a title 1`] = `"<div class="surface-card mt-3 p-4 sm:p-5"><div class="mb-3 flex items-baseline justify-between gap-3"><span class="font-medium text-[13px] text-[var(--text-muted)]">2330</span><span class="text-[11px] text-[var(--text-muted)]">公司概況</span></div><div class="grid grid-cols-2 gap-3 sm:grid-cols-3"><div class="min-w-0"><p class="truncate text-[11px] text-[var(--text-muted)]">市值</p><p class="font-num text-[14px] text-[var(--text)] tabular-nums" title="19,419,932,400">194.2億</p></div><div class="min-w-0"><p class="truncate text-[11px] text-[var(--text-muted)]">EPS</p><p class="font-num text-[14px] text-[var(--text)] tabular-nums">12,345.678</p></div></div></div>"`;
