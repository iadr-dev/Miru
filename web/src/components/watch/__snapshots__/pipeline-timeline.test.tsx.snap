// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PipelineTimeline interaction > a marker opens its detail card on focus and click toggles it 1`] = `
[
  "<div class="mt-1 rounded-[var(--radius-input)] p-3 text-[12px]" style="background-color: color-mix(in srgb, var(--chart-1) 8%, transparent); border-left: 3px solid var(--chart-1); opacity: 0; transform: translateY(-4px);"><p class="mb-1 font-medium text-[12.5px] text-[var(--text)]">08:00 選股</p><p class="text-[var(--text-muted)] leading-relaxed">用前一個交易日的收盤、法人與籌碼資料選出今日清單，並算好每檔的觸發價位。</p><ul class="mt-2 space-y-0.5 border-[var(--border)] border-t pt-2 text-[var(--text)]"><li>選出 5 檔</li></ul></div>",
  "<div class="mt-1 rounded-[var(--radius-input)] p-3 text-[12px]" style="background-color: color-mix(in srgb, var(--chart-7) 8%, transparent); border-left: 3px solid var(--chart-7); opacity: 0; transform: translateY(-4px);"><p class="mb-1 font-medium text-[12.5px] text-[var(--text)]">09:00–13:30 盯盤</p><p class="text-[var(--text-muted)] leading-relaxed">盤中每 10 分鐘用交易所即時報價檢查清單上的條件，連續兩次成立才通知。</p><ul class="mt-2 space-y-0.5 border-[var(--border)] border-t pt-2 text-[var(--text)]"><li>2/28 次檢查</li><li>10:00 · 檢查 12 檔，2 檔條件全數成立，1 檔通知</li></ul></div>",
  "<div class="mt-1 rounded-[var(--radius-input)] p-3 text-[12px]" style="background-color: color-mix(in srgb, var(--warn) 8%, transparent); border-left: 3px solid var(--warn); opacity: 0; transform: translateY(-4px);"><p class="mb-1 font-medium text-[12.5px] text-[var(--text)]">17:40 補股價・融資</p><p class="text-[var(--text-muted)] leading-relaxed">收盤後補進當日股價與融資融券，供收盤確認與明早選股使用。</p><ul class="mt-2 space-y-0.5 border-[var(--border)] border-t pt-2 text-[var(--text)]"><li>資料未更新</li></ul></div>",
  "<div class="mt-1 rounded-[var(--radius-input)] p-3 text-[12px]" style="background-color: color-mix(in srgb, var(--chart-2) 8%, transparent); border-left: 3px solid var(--chart-2); opacity: 0; transform: translateY(-4px);"><p class="mb-1 font-medium text-[12.5px] text-[var(--text)]">18:00 收盤確認</p><p class="text-[var(--text-muted)] leading-relaxed">用收盤價與成交量確認突破，條件成立時另外通知。</p><ul class="mt-2 space-y-0.5 border-[var(--border)] border-t pt-2 text-[var(--text)]"><li>1 檔收盤確認</li></ul></div>",
  "<div class="mt-1 rounded-[var(--radius-input)] p-3 text-[12px]" style="background-color: color-mix(in srgb, var(--chart-4) 8%, transparent); border-left: 3px solid var(--chart-4); opacity: 0; transform: translateY(-4px);"><p class="mb-1 font-medium text-[12.5px] text-[var(--text)]">20:10 補三大法人</p><p class="text-[var(--text-muted)] leading-relaxed">補進三大法人買賣超，供明早選股計算法人連買與籌碼。</p></div>",
]
`;

exports[`PipelineTimeline interaction > a stale step's detail card carries the stale line 1`] = `"<div class="mt-1 rounded-[var(--radius-input)] p-3 text-[12px]" style="background-color: color-mix(in srgb, var(--warn) 8%, transparent); border-left: 3px solid var(--warn); opacity: 0; transform: translateY(-4px);"><p class="mb-1 font-medium text-[12.5px] text-[var(--text)]">17:40 補股價・融資</p><p class="text-[var(--text-muted)] leading-relaxed">收盤後補進當日股價與融資融券，供收盤確認與明早選股使用。</p><ul class="mt-2 space-y-0.5 border-[var(--border)] border-t pt-2 text-[var(--text)]"><li>資料未更新</li></ul></div>"`;

exports[`PipelineTimeline interaction > hover opens and leaving closes only the hovered step 1`] = `""`;

