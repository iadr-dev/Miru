exports[`BillingPanel states > a canceled subscription is treated as none 1`] = `"<section class="surface-card p-4 sm:p-5 mb-6"><h2 class="font-semibold text-[18px] text-[var(--text)]">目前訂閱</h2><div class="mt-4 divide-y divide-[var(--border)]"><p class="text-[13px] text-[var(--text-muted)]">目前沒有進行中的訂閱。</p><div class="flex flex-col gap-2 py-4 first:pt-0 last:pb-0 sm:flex-row sm:items-center sm:justify-between sm:gap-4"><div class="min-w-0"><p class="font-medium text-[14px] text-[var(--text)]">自帶金鑰已啟用</p></div><div class="shrink-0"><span class="text-[13px] text-[var(--text)]">否</span></div></div></div></section><section class="surface-card p-4 sm:p-5 mb-6"><h2 class="font-semibold text-[18px] text-[var(--text)]">各方案包含什麼</h2><div class="mt-4 divide-y divide-[var(--border)]"></div></section><section class="surface-card p-4 sm:p-5 mb-6"><h2 class="font-semibold text-[18px] text-[var(--text)]">方案選擇</h2><div class="mt-4 divide-y divide-[var(--border)]"><div class="space-y-4 py-1"><div class="flex flex-col gap-2 py-4 first:pt-0 last:pb-0 sm:flex-row sm:items-center sm:justify-between sm:gap-4"><div class="min-w-0"><p class="font-medium text-[14px] text-[var(--text)]">方案等級</p></div><div class="shrink-0"><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] w-40" aria-label="方案等級"><option value="premium">Premium</option><option value="pro">Pro</option></select></div></div><div class="flex flex-col gap-2 py-4 first:pt-0 last:pb-0 sm:flex-row sm:items-center sm:justify-between sm:gap-4"><div class="min-w-0"><p class="font-medium text-[14px] text-[var(--text)]">計費週期</p></div><div class="shrink-0"><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] w-40" aria-label="計費週期"><option value="monthly">月付</option><option value="annual">年付</option></select></div></div><div class="flex flex-col gap-2 py-4 first:pt-0 last:pb-0 sm:flex-row sm:items-center sm:justify-between sm:gap-4"><div class="min-w-0"><p class="font-medium text-[14px] text-[var(--text)]">自帶金鑰</p></div><div class="shrink-0"><label class="flex min-h-11 items-center gap-2 text-[14px] text-[var(--text)]"><input class="size-4 rounded border-[var(--border)] accent-[var(--accent)] !outline-none focus-visible:rounded-[3px] focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-1" type="checkbox">使用自己的 LLM API 金鑰</label></div></div><div class="flex flex-col gap-2 py-4 first:pt-0 last:pb-0 sm:flex-row sm:items-center sm:justify-between sm:gap-4"><div class="min-w-0"><p class="font-medium text-[14px] text-[var(--text)]">價格</p><p class="mt-0.5 text-[12px] text-[var(--text-muted)]">稅額依帳單地址於結帳時計算。</p></div><div class="shrink-0"><span class="font-medium text-[14px] text-[var(--text)] tabular-nums">$299.00 / 月</span></div></div><button type="button" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-[var(--accent)] text-[var(--on-accent)] hover:opacity-90 font-medium min-h-11 px-4 text-sm">前往結帳</button></div></div></section><section class="surface-card p-4 sm:p-5"><h2 class="font-semibold text-[18px] text-[var(--text)]">帳務紀錄</h2><div class="mt-4 divide-y divide-[var(--border)]"><p class="text-[13px] text-[var(--text-muted)]">尚無帳務紀錄。</p></div></section>"`;

