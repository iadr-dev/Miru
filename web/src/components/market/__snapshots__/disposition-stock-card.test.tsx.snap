exports[`DispositionStockCard characterization > colours a negative institutional net 1`] = `"<div class="surface-card flex flex-col p-4"><div class="flex items-start justify-between gap-2"><div class="min-w-0"><p class="truncate font-medium text-[14px] text-[var(--text)]">2330<span class="ml-1.5 text-[11.5px] text-[var(--text-muted)]">2330</span></p><div class="mt-0.5 flex flex-wrap items-center gap-1"><span class="inline-block rounded-[var(--radius-pill)] bg-[var(--surface-2)] px-1.5 py-0.5 text-[10.5px] text-[var(--text-muted)]">上櫃</span></div></div><span class="shrink-0 rounded-[var(--radius-pill)] px-2 py-0.5 font-medium text-[11px] bg-[var(--surface-2)] text-[var(--warn)]">風險股</span></div><div class="mt-2 flex items-baseline gap-2"><span class="font-num text-[20px] text-[var(--text)] tabular-nums">—</span></div><dl class="mt-2.5 grid grid-cols-2 gap-y-1 text-[12px]"><dt class="text-[var(--text-muted)]">成交張數</dt><dd class="text-right font-num tabular-nums" style="color: var(--text);">—</dd><dt class="text-[var(--text-muted)]">成交值</dt><dd class="text-right font-num tabular-nums" style="color: var(--text);">—</dd><dt class="text-[var(--text-muted)]">三大法人買賣超</dt><dd class="text-right font-num tabular-nums" style="color: var(--down);">-1200</dd><dt class="text-[var(--text-muted)]">券資率%</dt><dd class="text-right font-num tabular-nums" style="color: var(--text);">—</dd><dt class="text-[var(--text-muted)]">當沖率%</dt><dd class="text-right font-num tabular-nums" style="color: var(--text);">—</dd></dl><div class="mt-2.5 flex flex-wrap gap-1"><span class="rounded-[var(--radius-pill)] px-1.5 py-0.5 text-[10.5px] bg-[var(--surface-2)] text-[var(--text-muted)]/50">資</span><span class="rounded-[var(--radius-pill)] px-1.5 py-0.5 text-[10.5px] bg-[var(--surface-2)] text-[var(--text-muted)]/50">券</span><span class="rounded-[var(--radius-pill)] px-1.5 py-0.5 text-[10.5px] bg-[var(--surface-2)] text-[var(--text-muted)]/50">沖</span><span class="rounded-[var(--radius-pill)] px-1.5 py-0.5 text-[10.5px] bg-[var(--surface-2)] text-[var(--text-muted)]/50">警</span><span class="rounded-[var(--radius-pill)] px-1.5 py-0.5 text-[10.5px] bg-[var(--surface-2)] text-[var(--text-muted)]/50">處</span><span class="rounded-[var(--radius-pill)] px-1.5 py-0.5 text-[10.5px] bg-[var(--surface-2)] text-[var(--text-muted)]/50">注</span></div><p class="mt-1.5 text-[10.5px] text-[var(--text-muted)] leading-relaxed">「還差N次進入處置」與「預估約N個交易日後進入處置」皆為本站自訂規則估算 — 滾動 10 個交易日內累積 3 次注意股即視為進入處置；交易日數字是再依該股自身觀察到的注意股頻率外推換算，屬於估算之上的估算，並非台灣證交所公告之官方數字，且僅涵蓋本功能上線後累積的注意股歷史。</p></div>"`;

