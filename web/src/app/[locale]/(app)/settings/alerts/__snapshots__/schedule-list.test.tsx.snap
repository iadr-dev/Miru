led:opacity-50 bg-transparent text-[var(--text)] hover:bg-[var(--surface-2)] min-h-11 px-4 text-sm">取消</button><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-[var(--accent)] text-[var(--on-accent)] hover:opacity-90 font-medium min-h-11 px-4 text-sm">建立排程</button></div></form></div></div>"`;

exports[`ScheduleList states > shows a retryable error when the list fails 1`] = `"<div role="alert" class="flex items-start gap-3 rounded-[var(--radius-input)] border border-[var(--warn)]/40 bg-[var(--surface-2)] p-4 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256" class="mt-0.5 shrink-0 text-[var(--warn)]"><path d="M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM222.93,203.8a8.5,8.5,0,0,1-7.48,4.2H40.55a8.5,8.5,0,0,1-7.48-4.2,7.59,7.59,0,0,1,0-7.72L120.52,44.21a8.75,8.75,0,0,1,15,0l87.45,151.87A7.59,7.59,0,0,1,222.93,203.8ZM120,144V104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm20,36a12,12,0,1,1-12-12A12,12,0,0,1,140,180Z"></path></svg><div class="min-w-0 flex-1"><p class="text-[var(--text)]">載入失敗，請重試。</p><button type="button" class="mt-2 font-medium text-[var(--accent-text)] text-sm hover:underline">重試</button></div></div>"`;

exports[`ScheduleList states > shows the loading skeleton first 1`] = `"<div class="animate-pulse space-y-3" aria-hidden="true"><div class="h-14 rounded-[var(--radius-input)] bg-[var(--surface-2)]"></div><div class="h-14 rounded-[var(--radius-input)] bg-[var(--surface-2)]"></div></div>"`;

exports[`weekly watchlist review > has no ticker box or scope choice: a description, a weekday and a time instead 1`] = `"<div><ul class="divide-y divide-[var(--border)]"></ul><div class="mt-4"><form aria-label="新增排程" class="space-y-4 rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface-2)] p-4"><fieldset class="grid gap-3 sm:grid-cols-2"><div><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="schedule-template">簡報種類</label><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="schedule-template"><option value="tw_stock_report">台股個股完整分析報告</option><option value="us_stock_report">美股個股完整分析報告</option><option value="tw_etf_report">台股 ETF 完整分析報告</option><option value="us_etf_report">美股 ETF 完整分析報告</option><option value="pre_open_brief">盤前快訊</option><option value="after_close_chip">收盤後籌碼檢視</option><option value="disposition_watch">注意股／處置股檢查</option><option value="weekly_catalyst">每週催化事件掃描</option><option value="weekly_watchlist_review">每週自選股回顧</option></select><p class="mt-1 text-[12px] text-[var(--text-muted)]">每週六 09:00</p></div><p class="text-[13px] text-[var(--text-muted)] leading-relaxed sm:col-span-2">涵蓋你所有自選股群組（台股與美股分開列示）：每檔的一週漲跌、未來 7 天的除權息與其他事件，以及資料日期。只整理資料，不構成投資建議。</p><div><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="schedule-weekday">星期</label><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="schedule-weekday"><option value="1">一</option><option value="2">二</option><option value="3">三</option><option value="4">四</option><option value="5">五</option><option value="6">六</option><option value="0">日</option></select></div><div><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="schedule-time">時間（台北時間）</label><input class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] placeholder:text-[var(--text-muted)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] min-w-0" id="schedule-time" aria-invalid="false" type="time" value="09:00"></div></fieldset><p class="text-[12px] text-[var(--text-muted)]">每次執行時才產生內容，並累積在同一個對話中，會計入你的對話額度。</p><div class="flex justify-end gap-2"><button type="button" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-transparent text-[var(--text)] hover:bg-[var(--surface-2)] min-h-11 px-4 text-sm">取消</button><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-[var(--accent)] text-[var(--on-accent)] hover:opacity-90 font-medium min-h-11 px-4 text-sm">建立排程</button></div></form></div></div>"`;
