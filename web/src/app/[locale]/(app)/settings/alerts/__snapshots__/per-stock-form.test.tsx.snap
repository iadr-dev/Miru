exports[`PerStockForm > lists the members with their latest close, skipping unsupported markets 1`] = `"<form aria-label="逐檔設定價位" class="space-y-4 rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface-2)] p-4"><div><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="perstock-group">自選股群組</label><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="perstock-group"><option value="">選擇群組</option><option value="g_empty">空群組</option><option value="g_mix">混合</option><option value="g_many">很多</option></select><p class="mt-1 text-[12px] text-[var(--text-muted)]">每檔股票價位不同，請逐檔設定；價位留空的股票會略過。建立後每檔都是獨立的提醒，可以各自編輯或刪除。</p></div><div class="flex flex-wrap items-center gap-2 text-[13px]"><span class="text-[var(--text-muted)]">全部空白列：</span><div class="w-28"><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" aria-label="批次條件"><option value="above">高於</option><option value="below">低於</option></select></div><span class="text-[var(--text-muted)]">現價</span><div class="w-24"><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" aria-label="批次幅度"><option value="3">+3%</option><option value="5">+5%</option><option value="10">+10%</option></select></div><button type="button" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-transparent text-[var(--text)] border border-[var(--border)] hover:bg-[var(--surface-2)] min-h-11 px-4 text-sm">依現價填入</button></div><div class="overflow-x-auto"><table class="w-full text-left text-[13px]"><caption class="sr-only">逐檔設定價位</caption><thead class="text-[var(--text-muted)]"><tr><th scope="col" class="py-1 pr-3 font-normal">標的</th><th scope="col" class="py-1 pr-3 text-right font-normal">最近收盤</th><th scope="col" class="py-1 pr-3 font-normal">條件</th><th scope="col" class="py-1 pr-3 font-normal">價位</th><th scope="col" class="py-1 font-normal">快速填入（依該檔現價）</th></tr></thead><tbody class="divide-y divide-[var(--border)]"><tr><td class="py-2 pr-3 font-medium text-[var(--text)]">2330</td><td class="py-2 pr-3 text-right font-num tabular-nums">100</td><td class="py-2 pr-3"><div class="w-28"><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" aria-label="2330 的條件"><option value="above">高於</option><option value="below">低於</option></select></div></td><td class="py-2 pr-3"><div class="w-28"><input class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] placeholder:text-[var(--text-muted)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] font-num tabular-nums" inputmode="decimal" aria-label="2330 的價位" value=""></div></td><td class="py-2"><div class="flex flex-wrap gap-1 whitespace-nowrap"><button type="button" class="rounded-full border border-[var(--border)] px-2 py-0.5 text-[12px] text-[var(--text-muted)] hover:text-[var(--text)] disabled:opacity-40">+5%</button><button type="button" class="rounded-full border border-[var(--border)] px-2 py-0.5 text-[12px] text-[var(--text-muted)] hover:text-[var(--text)] disabled:opacity-40">+10%</button><button type="button" class="rounded-full border border-[var(--border)] px-2 py-0.5 text-[12px] text-[var(--text-muted)] hover:text-[var(--text)] disabled:opacity-40">-5%</button></div></td></tr><tr><td class="py-2 pr-3 font-medium text-[var(--text)]">2317</td><td class="py-2 pr-3 text-right font-num tabular-nums">100</td><td class="py-2 pr-3"><div class="w-28"><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" aria-label="2317 的條件"><option value="above">高於</option><option value="below">低於</option></select></div></td><td class="py-2 pr-3"><div class="w-28"><input class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] placeholder:text-[var(--text-muted)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] font-num tabular-nums" inputmode="decimal" aria-label="2317 的價位" value=""></div></td><td class="py-2"><div class="flex flex-wrap gap-1 whitespace-nowrap"><button type="button" class="rounded-full border border-[var(--border)] px-2 py-0.5 text-[12px] text-[var(--text-muted)] hover:text-[var(--text)] disabled:opacity-40">+5%</button><button type="button" class="rounded-full border border-[var(--border)] px-2 py-0.5 text-[12px] text-[var(--text-muted)] hover:text-[var(--text)] disabled:opacity-40">+10%</button><button type="button" class="rounded-full border border-[var(--border)] px-2 py-0.5 text-[12px] text-[var(--text-muted)] hover:text-[var(--text)] disabled:opacity-40">-5%</button></div></td></tr><tr><td class="py-2 pr-3 font-medium text-[var(--text)]">AAPL</td><td class="py-2 pr-3 text-right font-num tabular-nums">200</td><td class="py-2 pr-3"><div class="w-28"><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" aria-label="AAPL 的條件"><option value="above">高於</option><option value="below">低於</option></select></div></td><td class="py-2 pr-3"><div class="w-28"><input class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] placeholder:text-[var(--text-muted)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] font-num tabular-nums" inputmode="decimal" aria-label="AAPL 的價位" value=""></div></td><td class="py-2"><div class="flex flex-wrap gap-1 whitespace-nowrap"><button type="button" class="rounded-full border border-[var(--border)] px-2 py-0.5 text-[12px] text-[var(--text-muted)] hover:text-[var(--text)] disabled:opacity-40">+5%</button><button type="button" class="rounded-full border border-[var(--border)] px-2 py-0.5 text-[12px] text-[var(--text-muted)] hover:text-[var(--text)] disabled:opacity-40">+10%</button><button type="button" class="rounded-full border border-[var(--border)] px-2 py-0.5 text-[12px] text-[var(--text-muted)] hover:text-[var(--text)] disabled:opacity-40">-5%</button></div></td></tr></tbody></table></div><p class="text-[12px] text-[var(--text-muted)]">收盤價為最近一個交易日，僅供參考；「—」代表目前沒有資料。</p><fieldset class="grid gap-3 sm:grid-cols-2"><div><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="perstock-mode">通知頻率</label><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="perstock-mode"><option value="once">只通知一次</option><option value="once_per_day">條件成立時通知（成立後需先解除才會再通知）</option><option value="every_occurrence">每次資料更新且條件成立都通知</option></select></div><div><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="perstock-expiry">有效期</label><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="perstock-expiry"><option value="30">30 天</option><option value="90">90 天</option><option value="365">1 年</option><option value="never">不會過期</option></select></div></fieldset><div class="flex justify-end gap-2"><button type="button" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-transparent text-[var(--text)] hover:bg-[var(--surface-2)] min-h-11 px-4 text-sm">取消</button><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-[var(--accent)] text-[var(--on-accent)] hover:opacity-90 font-medium min-h-11 px-4 text-sm">建立 0 則提醒</button></div></form>"`;

exports[`PerStockForm > starts with only the group picker and a disabled submit 1`] = `"<form aria-label="逐檔設定價位" class="space-y-4 rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface-2)] p-4"><div><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="perstock-group">自選股群組</label><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="perstock-group"><option value="">選擇群組</option><option value="g_empty">空群組</option><option value="g_mix">混合</option><option value="g_many">很多</option></select><p class="mt-1 text-[12px] text-[var(--text-muted)]">每檔股票價位不同，請逐檔設定；價位留空的股票會略過。建立後每檔都是獨立的提醒，可以各自編輯或刪除。</p></div><div class="flex justify-end gap-2"><button type="button" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-transparent text-[var(--text)] hover:bg-[var(--surface-2)] min-h-11 px-4 text-sm">取消</button><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-[var(--accent)] text-[var(--on-accent)] hover:opacity-90 font-medium min-h-11 px-4 text-sm" disabled="">建立 0 則提醒</button></div></form>"`;
