exports[`ThemePage branches > renders a full page snapshot with a chain, a related strip and every header part 1`] = `"<div><div class="@container flex flex-col gap-4"><a href="/market" class="inline-flex min-h-11 w-fit items-center gap-1.5 text-[13px] text-[var(--accent-text)] hover:underline focus-visible:outline-2 focus-visible:outline-[var(--accent)]"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z"></path></svg>回到題材列表</a><header class="flex flex-col gap-2"><h1 class="break-words font-semibold text-[22px] text-[var(--text)] leading-tight">Laser Module<span class="ml-2 font-normal text-[14px] text-[var(--text-muted)]">Laser Module EN</span></h1><p class="max-w-prose text-[14px] text-[var(--text-muted)] leading-relaxed">Modules that steer light.</p><p class="font-num text-[12px] text-[var(--text-muted)] tabular-nums">4 檔成員</p><div class="flex flex-wrap items-center gap-x-2 gap-y-1.5"><span class="text-[12px] text-[var(--text-muted)]">相關題材</span><ul class="flex flex-wrap gap-1.5"><li><a href="/themes/film-coating" class="inline-flex min-h-11 items-center rounded-[var(--radius-pill)] border border-[var(--border)] px-3 text-[13px] text-[var(--text-muted)] transition-colors hover:text-[var(--text)] focus-visible:outline-2 focus-visible:outline-[var(--accent)]">Film Coating</a></li></ul></div></header><section aria-label="題材成員依上游、中游、下游分欄" class="flex flex-col gap-2"><h2 class="font-semibold text-[15px] text-[var(--text)]">上游 → 中游 → 下游</h2><div class="grid grid-cols-1 gap-3 @2xl:grid-cols-3"><section aria-label="上游" class="surface-card flex min-w-0 flex-col gap-2 border-t-2 p-3" style="border-top-color: var(--chart-1);"><h3 class="font-semibold text-[13px] text-[var(--text)]">上游</h3><ul class="flex flex-col gap-2"><li class="min-w-0"><a href="/stock/1001?market=TW" class="flex min-h-11 items-center justify-between gap-3 rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface-2)] px-3 py-2 transition-colors hover:border-[var(--border-strong)] focus-visible:outline-2 focus-visible:outline-[var(--accent)]"><span class="min-w-0"><span class="block truncate font-medium text-[13px] text-[var(--text)]">Name 1001</span><span class="block font-num text-[11px] text-[var(--text-muted)] tabular-nums">1001</span></span><span class="whitespace-nowrap font-num tabular-nums shrink-0 text-[13px]" style="color: var(--up);" role="img" aria-label="上漲 1.25%">▲ 1.25%</span></a></li></ul></section><section aria-label="中游" class="surface-card flex min-w-0 flex-col gap-2 border-t-2 p-3" style="border-top-color: var(--chart-3);"><h3 class="font-semibold text-[13px] text-[var(--text)]">中游</h3><ul class="flex flex-col gap-2"><li class="min-w-0"><a href="/stock/1002?market=TW" class="flex min-h-11 items-center justify-between gap-3 rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface-2)] px-3 py-2 transition-colors hover:border-[var(--border-strong)] focus-visible:outline-2 focus-visible:outline-[var(--accent)]"><span class="min-w-0"><span class="block truncate font-medium text-[13px] text-[var(--text)]">Name 1002</span><span class="block font-num text-[11px] text-[var(--text-muted)] tabular-nums">1002</span></span><span class="whitespace-nowrap font-num tabular-nums shrink-0 text-[13px]" style="color: var(--down);" role="img" aria-label="下跌 0.50%">▼ 0.50%</span></a></li></ul></section><section aria-label="下游" class="surface-card flex min-w-0 flex-col gap-2 border-t-2 p-3" style="border-top-color: var(--chart-4);"><h3 class="font-semibold text-[13px] text-[var(--text)]">下游</h3><ul class="flex flex-col gap-2"><li class="min-w-0"><a href="/stock/1003?market=TW" class="flex min-h-11 items-center justify-between gap-3 rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--