// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ScreenerWorkbench > renders the idle screen mode 1`] = `"<div class="flex min-h-full flex-col"><div data-testid="tabs" data-market="TW" data-mode="screen"><button type="button">to-us</button><button type="button">to-themes</button><button type="button">to-screen</button></div><div data-testid="meter">null</div><div data-testid="gate" data-passed="undefined" data-market="TW">{"exclude_disposition":true,"exclude_attention":true,"exclude_full_cash_delivery":true}</div><div class="flex flex-1 flex-col lg:flex-row"><div class="flex flex-col lg:h-full lg:w-[264px]"><div data-testid="builder" data-live="undefined" data-match="AND">[[],[],{"signals":[{"key":"sigA"}]}]<button type="button">edit</button></div><div class="mt-auto flex flex-col gap-3"><div data-testid="saved">[[],"AND",{"exclude_disposition":true,"exclude_attention":true,"exclude_full_cash_delivery":true}]<button type="button">load-with-gates</button><button type="button">load-no-gates</button></div></div></div><div class="flex-1"><div data-testid="presets" data-active="null" data-count="1"><button type="button">pick</button></div><p class="border-[var(--border)] border-y bg-[color-mix(in_srgb,var(--warn)_12%,transparent)] px-4 py-2 text-[12px] text-[var(--text-muted)]">⚠ 符合條件的清單，非推薦名單。</p></div></div></div>"`;

exports[`ScreenerWorkbench > shows loading, error with retry, empty with relax, and the table 1`] = `"<div class="flex min-h-full flex-col"><div data-testid="tabs" data-market="TW" data-mode="screen"><button type="button">to-us</button><button type="button">to-themes</button><button type="button">to-screen</button></div><div data-testid="meter">{"universe":100,"gated":60,"setup":10}</div><div data-testid="gate" data-passed="60" data-market="TW">{"exclude_disposition":true,"exclude_attention":true,"exclude_full_cash_delivery":true}</div><div class="flex flex-1 flex-col lg:flex-row"><div class="flex flex-col lg:h-full lg:w-[264px]"><div data-testid="builder" data-live="10" data-match="AND">[[],[],{"signals":[{"key":"sigA"}]}]<button type="button">edit</button></div><div class="mt-auto flex flex-col gap-3"><div data-testid="saved">[[],"AND",{"exclude_disposition":true,"exclude_attention":true,"exclude_full_cash_delivery":true}]<button type="button">load-with-gates</button><button type="button">load-no-gates</button></div><div data-testid="matchrate"></div></div></div><div class="flex-1"><div data-testid="presets" data-active="null" data-count="1"><button type="button">pick</button></div><p class="border-[var(--border)] border-y bg-[color-mix(in_srgb,var(--warn)_12%,transparent)] px-4 py-2 text-[12px] text-[var(--text-muted)]">⚠ 符合條件的清單，非推薦名單。</p><div data-testid="table" data-market="TW" data-cols="5">2</div></div></div></div>"`;
