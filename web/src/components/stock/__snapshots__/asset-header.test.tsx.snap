exports[`AssetHeader characterization > single EOD bar has a price but no change 1`] = `"<header class="z-10 border-[var(--border)] border-b bg-[var(--surface)] px-4 py-4 sm:sticky sm:top-0 sm:px-5"><div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2"><div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1"><h1 class="max-w-full truncate font-semibold text-[20px] text-[var(--text)]">測試公司</h1><span class="font-num text-[15px] text-[var(--text-muted)] tabular-nums">1001</span><span class="rounded-[var(--radius-pill)] px-2.5 py-1 font-medium text-[12px]" style="background-color: var(--chart-4)26; color: var(--chart-4); border: 1px solid var(--chart-4)40;">半導體業</span><i data-signals=""></i></div><div class="flex shrink-0 items-center gap-1.5"><i data-star="stock"></i><i data-alert="false"></i><a class="inline-flex min-h-11 items-center gap-1.5 rounded-[var(--radius-button)] px-3 text-[13px] text-[var(--accent-text)] transition-colors hover:bg-[var(--surface-2)]" href="/chat"><span aria-hidden="true" class="inline-flex" ><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256"><path d="M208,144a15.78,15.78,0,0,1-10.42,14.94L146,178l-19,51.62a15.92,15.92,0,0,1-29.88,0L78,178l-51.62-19a15.92,15.92,0,0,1,0-29.88L78,110l19-51.62a15.92,15.92,0,0,1,29.88,0L146,110l51.62,19A15.78,15.78,0,0,1,208,144ZM152,48h16V64a8,8,0,0,0,16,0V48h16a8,8,0,0,0,0-16H184V16a8,8,0,0,0-16,0V32H152a8,8,0,0,0,0,16Zm88,32h-8V72a8,8,0,0,0-16,0v8h-8a8,8,0,0,0,0,16h8v8a8,8,0,0,0,16,0V96h8a8,8,0,0,0,0-16Z"></path></svg></span>問 Miru</a></div></div><div class="mt-2 flex flex-wrap items-baseline gap-x-4 gap-y-1"><span role="group" aria-label="100" class="flex items-baseline gap-2"><span aria-hidden="true" class="font-display font-light text-[34px] tabular-nums leading-none" style="color: var(--text);">100.00</span></span></div><p class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-0.5 font-num text-[12px] tabular-nums"><span><span style="color: var(--chart-1);">開 </span><span class="text-[var(--text)]">99.00</span></span><span><span style="color: var(--chart-2);">高 </span><span class="text-[var(--text)]">102.00</span></span><span><span style="color: var(--chart-3);">低 </span><span class="text-[var(--text)]">97.00</span></span><span><span style="color: var(--chart-4);">量 </span><span class="text-[var(--text)]">123,456</span></span><span class="inline-flex items-center gap-1"><span aria-hidden="true" class="size-1.5 rounded-full bg-[var(--text-muted)]"></span>僅收盤資料</span></p></header>"`;
