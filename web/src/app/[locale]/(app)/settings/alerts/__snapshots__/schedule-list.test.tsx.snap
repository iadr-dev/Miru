exports[`ScheduleForm rendering > editing a stock job fills its targets and locks the briefing type 1`] = `"<div><ul class="divide-y divide-[var(--border)]"><li class="flex items-center justify-between gap-3 py-3"><div class="min-w-0"><p class="font-medium text-[14px] text-[var(--text)]">盤前快訊 · 2330、2317</p><p class="truncate text-[12px] text-[var(--text-muted)]">每個台股交易日開盤前 · 尚未執行</p></div><div class="flex shrink-0 items-center gap-2"><button type="button" role="switch" aria-checked="true" aria-label="切換 盤前快訊 · 2330、2317 的排程" class="inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] disabled:cursor-not-allowed disabled:opacity-50"><span class="relative inline-flex h-6 w-11 items-center rounded-[var(--radius-pill)] transition-colors bg-[var(--accent)]"><span class="inline-block size-5 translate-x-0.5 rounded-full bg-[var(--bg)] transition-transform translate-x-[22px]"></span></span></button><button type="button" aria-label="編輯 盤前快訊 · 2330、2317 的排程" class="inline-flex size-11 items-center justify-center rounded-[var(--radius-button)] text-[var(--text-muted)] hover:bg-[var(--surface-2)] hover:text-[var(--text)]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256"><path d="M227.31,73.37,182.63,28.68a16,16,0,0,0-22.63,0L36.69,152A15.86,15.86,0,0,0,32,163.31V208a16,16,0,0,0,16,16H92.69A15.86,15.86,0,0,0,104,219.31L227.31,96a16,16,0,0,0,0-22.63ZM92.69,208H48V163.31l88-88L180.69,120ZM192,108.68,147.31,64l24-24L216,84.68Z"></path></svg></button><button type="button" aria-label="刪除 盤前快訊 · 2330、2317 的排程" class="inline-flex size-11 items-center justify-center rounded-[var(--radius-button)] text-[var(--text-muted)] hover:bg-[var(--surface-2)] hover:text-[var(--warn)]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256"><path d="M216,48H176V40a24,24,0,0,0-24-24H104A24,24,0,0,0,80,40v8H40a8,8