# Copy to .env.local (gitignored) and adjust for your environment.

# The backend's /api/v1 origin. The frontend only ever talks to this — no other backend coupling.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Nothing else is needed here. The OAuth redirect_uri lives in backend/.env
# (GOOGLE_REDIRECT_URI / LINE_REDIRECT_URI point at the BACKEND's own callback route, not this
# app), and backend/.env's FRONTEND_BASE_URL is where that callback sends the browser back to
# (this app's origin, e.g. http://localhost:3000) after sign-in succeeds or fails.
