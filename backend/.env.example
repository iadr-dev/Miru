# ============================================================================
# backend/.env.example - template for backend/.env (which is GITIGNORED)
#
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# Secrets are KMS envelope-encrypted at rest in production; plain here for local dev.
# Authoritative reference: docs/backend/modules/16-infrastructure.md section 8.
#
# How to read this file
#   name=value     set (or change) this one; the value shown is the dev default or a placeholder
#   # name=value   optional; the value shown is the built-in default, uncomment only to change it
#   CHANGE_ME     a secret or id you must provide before that feature works
#
# Quick start (everything else can stay as it is):
#   1. DATABASE_URL         the default SQLite file works for local dev
#   2. JWT_SECRET_KEY, SECRET_ENCRYPTION_KEYS
#   3. FINMIND_API_KEY      (market data) and one LLM key such as ANTHROPIC_API_KEY
#
# Sections:  1 Runtime  2 Datastores  3 Sign-in & secrets  4 LLM  5 Data providers
#            6 Supply-chain research  7 Notifications  8 Payments  9 MCP server & OAuth
#            10 Limits & caches  11 Voice, attachments, web push
# ============================================================================


# ============================================================================
# 1. Runtime
# ============================================================================
ENV=development                          # development | production
FRONTEND_BASE_URL=https://your-domain.example   # where OAuth callbacks send the browser afterwards
WEBHOOK_BASE_URL=https://your-domain.example    # public base for webhook callbacks
# CORS_ALLOWED_ORIGINS=http://localhost:3000    # comma-separated; empty = no CORS middleware
# strict | compatibility | unsafe-explicit - never silently downgraded (sources/tls.py).
TLS_POLICY=strict
# LOG_FORMAT=auto                        # auto (json in production) | json | console
# LOG_LEVEL=INFO
# TRUSTED_PROXY_COUNT=0                  # reverse proxies of your own in front of the API
# SHUTDOWN_GRACE_SECONDS=30              # a stopping API waits this long for chat turns to finish
# UNATTENDED_TURN_LIMIT_SECONDS=600      # how long a turn keeps running after its client left

# Background processes
SCHEDULER_POLL_INTERVAL_SECONDS=60
INGEST_POLL_INTERVAL_SECONDS=60
# Dev-only startup catch-up ingest. MUST be false in production (the leader scheduler owns ingest).
# False in dev too: otherwise every restart auto-runs a multi-year backfill that can starve a shared
# dev host. Seed explicitly with `dev-backend.sh --backfill`, or set true to opt back in.
INGEST_ON_STARTUP=false
DEV_BACKFILL_YEARS=3                     # first-run dev backfill window (not full history)


# ============================================================================
# 2. Datastores
# ============================================================================
# App state: SQLite (dev) / Postgres (prod). Market data is NOT here (Parquet + Redis).
DATABASE_URL=sqlite+aiosqlite:///./dev.db    # prod: postgresql+asyncpg://user:pass@host/db
# SCHEMA_UPGRADE_MODE=strict             # strict: refuse a stale DB (reset it) | additive: patch in place
# ROW_LEVEL_SECURITY=false               # Postgres RLS backstop; the app must connect as an ordinary role

# Postgres pool and guard rails (ignored for SQLite)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=1800
# DB_POOL_TIMEOUT_SECONDS=10             # how long a request waits for a free connection
# DB_STATEMENT_TIMEOUT_MS=30000          # 0 disables
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000   # ends a session idle inside a transaction; 0 disables

# Docker Compose only (backend/docker-compose.yml): the compose Postgres password and role.
# DATABASE_URL must then embed the same values. Never used outside the local compose stack.
POSTGRES_PASSWORD=CHANGE_ME
# DB_USER=miru                           # miru_app = ordinary role (needed for ROW_LEVEL_SECURITY)

# Market data (the leader ingest writes Parquet here; API workers read it)
PARQUET_ROOT=./data/parquet
REDIS_URL=redis://localhost:6379/0       # SSE fan-out, caches, locks, quota counters (when a backend below is "redis")
YF_TZ_CACHE_DIR=./.cache/yf_tz           # yfinance's tz cache - writable, persistent path

# Private reference data (supply-chain relations, concept themes, entity catalog). Gitignored and
# never committed; the files are the source of truth and the database only indexes them.
# REFERENCE_DATA_DIR=./reference-data


# ============================================================================
# 3. Sign-in & secrets
# ============================================================================
# ---- JWT session (access token ~15 min, not 1440) ----
JWT_SECRET_KEY=CHANGE_ME                 # generate a strong random secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# BYOK and channel-token envelope encryption: comma-separated Fernet keys (accounts/crypto.py).
SECRET_ENCRYPTION_KEYS=CHANGE_ME

# ---- OAuth sign-in (modules/12, adr/0022): Google, LINE Login, Telegram Login ----
# redirect_uri points at THIS BACKEND's own /callback route and must match what the provider
# console has on file; the callback then redirects the browser to FRONTEND_BASE_URL.
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://your-domain.example/api/v1/auth/oauth/google/callback

# LINE Login is a SEPARATE channel from LINE Messaging (section 7).
LINE_CHANNEL_ID=CHANGE_ME
LINE_CHANNEL_SECRET=CHANGE_ME
LINE_REDIRECT_URI=https://your-domain.example/api/v1/auth/oauth/line/callback

# Telegram (OIDC): @BotFather -> your bot -> Login Widget -> add the redirect URI below to Allowed
# URLs; BotFather then shows the Client ID (defaults to the bot's id) and Client Secret.
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=CHANGE_ME
TELEGRAM_LOGIN_REDIRECT_URI=https://your-domain.example/api/v1/auth/oauth/telegram/callback


# ============================================================================
# 4. LLM (provider-agnostic adapter - modules/04). Set the keys you use.
# ============================================================================
# ---- Provider keys ----
ANTHROPIC_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
OPENROUTER_API_KEY=CHANGE_ME
# Local models: no key. Ollama's default URL is below. Docker Desktop Model Runner serves the same
# OpenAI-style API (the client adds /v1): from the host use the TCP port you enabled
# (Settings > AI > host-side TCP), e.g. http://localhost:58130/engines; from a container use
# http://model-runner.docker.internal/engines.
OLLAMA_BASE_URL=http://localhost:11434
# docker compose ignores OLLAMA_BASE_URL and points containers at Model Runner's in-container
# address; set this only if Model Runner is reachable somewhere else from your containers.
# DOCKER_MODEL_RUNNER_URL=http://model-runner.docker.internal/engines

# ---- Which model serves which role ----
# Roles: classifier (routing, titles), agent (reply loop), subagent (fan-out lanes, summaries),
# synthesis (final answer). Users with their own key (BYOK) run on their key and a curated model
# map instead; the settings below are for users without one.
# Platform model profile: hosted (default chains below) or local (every role on
# ollama/$LOCAL_MODEL_ID at OLLAMA_BASE_URL). If the local endpoint is down the turn fails with a
# calm 503 unless LOCAL_FALLBACK_TO_HOSTED=true. MODEL_ROLE_* below always win over the profile.
# PLATFORM_MODEL_PROFILE=hosted
# LOCAL_MODEL_ID=ai/qwen3.6:latest
# LOCAL_FALLBACK_TO_HOSTED=false
# Per-role overrides: "provider/model", comma-separated for a fallback chain; see llm/registry.py.
# MODEL_ROLE_CLASSIFIER=anthropic/claude-haiku-5-5
# MODEL_ROLE_AGENT=anthropic/claude-sonnet-5-5
# MODEL_ROLE_SUBAGENT=anthropic/claude-sonnet-5-5
# MODEL_ROLE_SYNTHESIS=openai/gpt-4o-mini
# LLM_PROVIDER=anthropic                 # optional default-client override
# LLM_MODEL=claude-...                   # optional default-client override

# ---- Context window and per-turn budgets ----
CONTEXT_WINDOW_TOKENS=128000
CONTEXT_RESERVE_TOKENS=4000
AGENT_MAX_STEPS=8
LLM_MAX_OUTPUT_TOKENS=16000
# LLM_CACHE_DIAGNOSTICS=false            # log why the Anthropic prompt cache missed (llm_cache_miss)
# Orchestrator per-turn ceilings (orchestrator/ceilings.py)
ORCH_MAX_SUBAGENTS=6
ORCH_MAX_STEPS_PER_AGENT=8
ORCH_MAX_TOOL_CALLS_PER_TURN=60
ORCH_MAX_COST_MICROS_PER_TURN=7500000
ORCH_MAX_TOKENS_PER_TURN=1500000


# ============================================================================
# 5. Data providers
# ============================================================================
# FinMind: the market-data source. Whole-market-by-date ingest needs a paid tier; the free tier is
# per-symbol only and will not power the daily ingest.
FINMIND_API_KEY=CHANGE_ME
FINMIND_BASE_URL=https://api.finmindtrade.com/api/v4
# Web search (Brave): used when the active LLM has no native search, and by the research pipeline.
BRAVE_SEARCH_API_KEY=CHANGE_ME
# US market data / analyst (optional)
FINNHUB_KEY=CHANGE_ME
# US macro series (St. Louis Fed FRED). Free key: https://fredaccount.stlouisfed.org/apikeys.
# Blank is fine: the nightly `fred_macro` ingest job journals SKIPPED and the US macro tools say
# "not available yet". Used by ingest only, never on the request path.
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred


# ============================================================================
# 6. Supply-chain research (analytics/supply_chain/verification)
# ============================================================================
# Budgeted web research that writes evidence-backed rows into the private relation files. Needs
# BRAVE_SEARCH_API_KEY and an LLM key. OFF by default and off in production; every cap below ends a
# run gracefully. Run by hand with `python -m analytics.supply_chain discover|verify --dry-run`.
# SUPPLY_CHAIN_RESEARCH_ENABLED=false
# SUPPLY_CHAIN_RESEARCH_MODEL=            # research judge only ("provider/model"); blank = the subagent role
# SUPPLY_CHAIN_RESEARCH_SECOND_MODEL=openai/gpt-5.6-sol   # second opinion; a different vendor from the judge
# SUPPLY_CHAIN_SECOND_OPINION=false
# SUPPLY_CHAIN_RESEARCH_MAX_CLAIMS=25
# SUPPLY_CHAIN_RESEARCH_MAX_SEARCHES=60
# SUPPLY_CHAIN_RESEARCH_MAX_PAGES=90
# SUPPLY_CHAIN_RESEARCH_MAX_LLM_CALLS=120
# SUPPLY_CHAIN_RESEARCH_BUDGET_USD=2.0
# SUPPLY_CHAIN_PAGES_PER_CLAIM=3
# SUPPLY_CHAIN_REVERIFY_DAYS=365
# SUPPLY_CHAIN_REJECT_COOLDOWN_DAYS=90
# SUPPLY_CHAIN_MAX_SOURCE_AGE_DAYS=1095
# SUPPLY_CHAIN_GAP_TOP_N=50


# ============================================================================
# 7. Notification delivery channels (modules/14) - NOT for sign-in
# ============================================================================
# LINE Messaging API is a distinct channel from LINE Login (section 3).
LINE_MESSAGING_CHANNEL_SECRET=CHANGE_ME
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=CHANGE_ME
LINE_BOT_BASIC_ID=@your_bot
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_USERNAME=your_bot
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
# Email via Resend (https://resend.com). The from-address must use a domain verified there.
RESEND_API_KEY=CHANGE_ME
# Shown when you add <WEBHOOK_BASE_URL>/api/v1/webhooks/resend in Resend > Webhooks.
RESEND_WEBHOOK_SECRET=whsec_CHANGE_ME
EMAIL_FROM_ADDRESS=alerts@your-domain.example


# ============================================================================
# 8. Payments - Paddle (modules/15). Merchant of record; the webhook is the entitlement source of truth.
# ============================================================================
# 8 price ids = {premium, pro} x {monthly, annual} x {standard, BYOK}.
PADDLE_API_KEY=CHANGE_ME
PADDLE_ENVIRONMENT=sandbox               # sandbox | production
PADDLE_WEBHOOK_SECRET=CHANGE_ME
PADDLE_CLIENT_TOKEN=CHANGE_ME            # publishable Paddle.js token (safe to expose)
PADDLE_PRICE_PREMIUM_MONTHLY=pri_CHANGE_ME
PADDLE_PRICE_PREMIUM_ANNUAL=pri_CHANGE_ME
PADDLE_PRICE_PREMIUM_BYOK_MONTHLY=pri_CHANGE_ME
PADDLE_PRICE_PREMIUM_BYOK_ANNUAL=pri_CHANGE_ME
PADDLE_PRICE_PRO_MONTHLY=pri_CHANGE_ME
PADDLE_PRICE_PRO_ANNUAL=pri_CHANGE_ME
PADDLE_PRICE_PRO_BYOK_MONTHLY=pri_CHANGE_ME
PADDLE_PRICE_PRO_BYOK_ANNUAL=pri_CHANGE_ME


# ============================================================================
# 9. MCP server and its OAuth (separate process: `python -m mcp`; OAuth lives in the API: /oauth/*)
# ============================================================================
# ---- MCP server: a standalone remote streamable-HTTP process, never wired into the main API ----
MCP_HOST=0.0.0.0
MCP_PORT=8100
MCP_ALLOWED_ORIGINS=                     # comma-separated; empty = FastMCP's own safe defaults
MCP_ALLOWED_HOSTS=                       # comma-separated; empty = FastMCP's own safe defaults
# Public HTTPS origin of this server behind a tunnel or reverse proxy, e.g. https://mcp.example.com
# (no path, no trailing slash). Its host/origin are allow-listed automatically; empty = local only.
# Required for Claude connectors (claude.ai custom connector, Messages API mcp_servers).
MCP_PUBLIC_BASE_URL=
# true (default) = every /mcp request needs an OAuth token this app issued; false = anonymous Free
# access, local development only.
MCP_REQUIRE_AUTH=true
# Development only: also accept the web app's own session JWT. Keep false where real users connect.
MCP_ACCEPT_APP_ACCESS_TOKEN=false
MCP_STATELESS_HTTP=true                  # no Mcp-Session-Id; right for load balancers and connectors
# Edge limits on /mcp, counted per user id (valid token) or per client address (TRUSTED_PROXY_COUNT).
MCP_MAX_BODY_BYTES=1048576
MCP_MAX_CONCURRENT_REQUESTS=64
MCP_RATE_LIMIT_ANONYMOUS_PER_MINUTE=120
MCP_RATE_LIMIT_SIGNED_IN_PER_MINUTE=600

# ---- OAuth authorization server for MCP clients ("sign in with your Miru account") ----
# Public base URL of the API service, scheme + host only, e.g. https://app.example.com. It is the
# `iss` of the MCP tokens and what the MCP server's protected-resource metadata points clients at.
# Needs MCP_PUBLIC_BASE_URL too (the token audience). Empty = MCP sign-in unavailable.
# The consent screen lives in the web app: <FRONTEND_BASE_URL>/<locale>/oauth/consent?request=<id>.
OAUTH_ISSUER=
OAUTH_ACCESS_TOKEN_MINUTES=10
OAUTH_REFRESH_TOKEN_DAYS=30
OAUTH_AUTHORIZATION_REQUEST_TTL_SECONDS=600   # time to approve on the consent screen
OAUTH_CODE_TTL_SECONDS=60                     # how long an issued code lives
# Extra redirect URI schemes a desktop client may register (besides https and http://localhost).
OAUTH_EXTRA_REDIRECT_SCHEMES=vscode,vscode-insiders,cursor,windsurf
# Client ID Metadata Documents (an https-URL client_id the server fetches): timeout, size cap and
# cache. Private, loopback and link-local addresses are always refused.
OAUTH_CIMD_TIMEOUT_SECONDS=5
OAUTH_CIMD_MAX_BYTES=65536
OAUTH_CIMD_CACHE_SECONDS=300
# Abuse bounds on the unauthenticated endpoints (per client address) and the client table size.
OAUTH_REGISTER_PER_HOUR=20
OAUTH_TOKEN_PER_MINUTE=120
OAUTH_MAX_REGISTERED_CLIENTS=10000
OAUTH_REGISTER_GLOBAL_PER_HOUR=600            # registrations across all callers per hour
OAUTH_MAX_CIMD_CLIENTS=5000                   # metadata-document client cap
OAUTH_CIMD_FETCH_PER_MINUTE=6                 # NEW metadata documents one address may make us fetch
OAUTH_UNUSED_CLIENT_DAYS=3                    # how long a never-approved client is kept
# Comma-separated client_ids you vouch for; the consent screen warns about every other client.
OAUTH_VERIFIED_CLIENT_IDS=


# ============================================================================
# 10. Limits and caches (defaults are fine for dev; the dev-parity compose stack forces "redis")
# ============================================================================
# ---- Backends: "memory" is the non-network default ----
# EVENT_BUS_BACKEND=memory               # memory | redis
# RATE_LIMITER_BACKEND=memory            # memory | redis
# MARKET_DATA_CACHE_BACKEND=none         # none | redis
# REDIS_REQUEST_TIMEOUT_SECONDS=2        # connect/reply timeout for request-path Redis calls
# REDIS_REQUEST_MAX_CONNECTIONS=50       # per client per process; a burst waits for a free one
RATE_LIMIT_KEY_PREFIX=ratelimit
DATA_UPDATED_KEY_PREFIX=data.updated

# ---- FinMind quota: the token's own cap, and the Sponsor pool split (usage/finmind_pool.py) ----
# FINMIND_CALLS_PER_WINDOW=6000          # the token's own cap (calls per window)
# FINMIND_CALL_WINDOW_SECONDS=3600
# FINMIND_INGEST_SHARE=0.5               # ingest uses at most this share; the rest stays for users
# FINMIND_QUOTA_KEY_PREFIX=finmind:calls
FINMIND_POOL_KEY_PREFIX=finmind:pool
FINMIND_POOL_LIMIT_PER_WINDOW=6000
FINMIND_POOL_WINDOW_SECONDS=3600
FINMIND_RESERVE_PER_LANE=1

# ---- Live-quote streaming (events/live_quote_factory.py) ----
QUOTE_POLL_CADENCE_NORMAL_SECONDS=5
QUOTE_POLL_CADENCE_SAVER_SECONDS=20
QUOTE_STREAM_MAX_SYMBOLS_PER_CONNECTION=50
QUOTE_STREAM_MAX_DEMANDED_SYMBOLS=500
QUOTE_CHANNEL_KEY_PREFIX=quote
QUOTE_DEMAND_KEY_PREFIX=demand
# QUOTE_DEMAND_LEASE_SECONDS=90          # a killed worker's quote-symbol claims expire after this

# ---- Market-data read-through cache (sources/caching_adapter.py) ----
MARKET_DATA_CACHE_KEY_PREFIX=mdcache
MARKET_DATA_CACHE_TTL_FAILURE_SECONDS=30
MARKET_DATA_CACHE_TTL_REFERENCE_SECONDS=86400
MARKET_DATA_CACHE_TTL_LIVE_ISH_SECONDS=15
MARKET_DATA_CACHE_TTL_OFFICIAL_EOD_SECONDS=3600
MARKET_DATA_CACHE_TTL_EVENT_DRIVEN_SECONDS=300


# ============================================================================
# 11. Voice, attachments, web push
# ============================================================================
# Voice (voice/providers.py): "stub" is the deterministic non-network default; real providers are opt-in.
VOICE_STT_PROVIDER=stub                  # stub | faster_whisper
VOICE_TTS_PROVIDER=stub                  # stub | edge_tts | openai

# Chat attachments (attachments/, api/attachments.py)
MAX_ATTACHMENT_SIZE_BYTES=10000000

# Browser notifications (Web Push / VAPID). Generate keys once (see
# docs/backend/modules/14-scheduler-alerts.md section 6); the public key is shown to browsers.
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:you@example.com
