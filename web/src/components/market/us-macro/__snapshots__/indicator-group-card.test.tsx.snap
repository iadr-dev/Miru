exports[`IndicatorGroupCard characterization > renders a category with few rows 1`] = `"<section aria-labelledby="us-macro-group-labor" class="surface-card flex min-w-0 flex-col p-4 sm:p-5"><h3 id="us-macro-group-labor" class="font-semibold text-[15px] text-[var(--text)]">就業</h3><p class="mt-0.5 mb-2 text-[12px] text-[var(--text-muted)]">失業率、新增就業人數與申請失業救濟金的人數。</p><ul class="-mx-2 flex flex-col divide-y divide-[var(--border)]"><li><button type="button" aria-haspopup="dialog" aria-label="查看 失業率 的詳細資料" class="flex min-h-11 w-full flex-col gap-1 rounded-[var(--radius-input)] px-2 py-2 text-left transition-colors hover:bg-[var(--surface-2)] active:bg-[var(--surface-3)] focus-visible:outline-2 focus-visible:outline-[var(--accent)] focus-visible:outline-offset-2"><span class="flex items-center gap-2"><span class="min-w-0 flex-1 truncate text-[13px] text-[var(--text)]">失業率<span class="text-[var(--text-muted)]"></span></span><span class="h-6 w-14 shrink-0"><svg viewBox="0 0 100 26" preserveAspectRatio="none" class="block h-full w-full" aria-hidden="true" role="presentation"><polyline points="0,26 25,17.333333333333357 50,8.666666666666643 75,17.333333333333357 100,0" fill="none" stroke="var(--chart-4)" stroke-width="1.6"></polyline></svg></span><span class="w-[5.5rem] shrink-0 text-right font-num font-semibold text-[14px] text-[var(--text)] tabular-nums">4.30%</span></span><span class="flex flex-wrap items-center gap-x-2.5 gap-y-0.5 text-[11.5px] text-[var(--text-muted)]"><span class="font-num tabular-nums">較前期 +0.20</span><span class="font-num tabular-nums">資料日期 2026年9月1日</span><span class="font-num tabular-nums">下次發布 2026年11月6日</span></span></button></li><li><button type="button" aria-haspopup="dialog" aria-label="查看 非農就業人數 的詳細資料" class="flex min-h-11 w-full flex-col gap-1 rounded-[var(--radius-input)] px-2 py-2 text-left transition-colors hover:bg-[var(--surface-2)] active:bg-[var(--surface-3)] focus-visible:outline-2 focus-visible:outline-[var(--accent)] focus-visible:outline-offset-2"><span class="flex items-center gap-2"><span class="min-w-0 flex-1 truncate text-[13px] text-[var(--text)]">非農就業人數<span class="text-[var(--text-muted)]"></span></span><span class="h-6 w-14 shrink-0"><svg viewBox="0 0 100 26" preserveAspectRatio="none" class="block h-full w-full" aria-hidden="true" role="presentation"><polyline points="0,26 25,17.333333333333357 50,8.666666666666643 75,17.333333333333357 100,0" fill="none" stroke="var(--chart-4)" stroke-width="1.6"></polyline></svg></span><span class="w-[5.5rem] shrink-0 text-right font-num font-semibold text-[14px] text-[var(--text)] tabular-nums">159,800</span></span><span class="flex flex-wrap items-center gap-x-2.5 gap-y-0.5 text-[11.5px] text-[var(--text-muted)]"><span class="font-num tabular-nums">較前期 +150</span><span class="font-num tabular-nums">資料日期 2026年9月1日</span><span class="font-num tabular-nums">下次發布 2026年11月6日</span></span></button></li></ul></section>"`;

