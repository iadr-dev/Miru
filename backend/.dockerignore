# Keep the build context minimal and secret-free. The runtime image needs only src/, the
# lockfile/project metadata, alembic.ini, and the entrypoint — everything below is dev-only,
# test-only, or sensitive.
.git
.gitignore
.env
.env.*
*.env
tests/
docs/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
dev.db
*.db
.cache/
data/
docker-compose.yml
Dockerfile
.dockerignore
