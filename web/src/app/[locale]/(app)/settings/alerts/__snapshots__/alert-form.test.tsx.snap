r(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="alert-trigger-mode"><option value="once">只通知一次</option><option value="once_per_day">條件成立時通知（成立後需先解除才會再通知）</option><option value="every_occurrence">每次資料更新且條件成立都通知</option></select></div><div><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="alert-expiry">有效期</label><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="alert-expiry"><option value="30">30 天</option><option value="90">90 天</option><option value="365">1 年</option><option value="never">不會過期</option></select></div></fieldset><p class="text-[13px] text-[var(--text-muted)]" aria-live="polite"><span class="font-medium text-[var(--text)]">預覽：</span>填寫完成後會在這裡顯示提醒條件。</p><div class="flex justify-end gap-2"><button type="button" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-transparent text-[var(--text)] hover:bg-[var(--surface-2)] min-h-11 px-4 text-sm">取消</button><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-[var(--accent)] text-[var(--on-accent)] hover:opacity-90 font-medium min-h-11 px-4 text-sm">建立提醒</button></div></form>"`;

