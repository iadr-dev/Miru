tle="上個月的對話" class="flex min-h-9 w-full items-center gap-2.5 rounded-[var(--radius-button)] px-3 text-left transition-colors text-[var(--text-muted)] hover:bg-[var(--surface-2)] hover:text-[var(--text)]" aria-pressed="false"><span aria-hidden="true" class="flex size-4 shrink-0 items-center justify-center rounded-[3px] border transition-colors border-[var(--border)] bg-transparent"></span><span class="min-w-0 flex-1 truncate text-[13px]">上個月的對話</span></button></li></ul></div><div class="pt-2 pb-1"><p class="px-3 pb-1 font-medium text-[11px] text-[var(--text-muted)] uppercase tracking-wide">更早</p><ul class="flex flex-col gap-0.5"><li class="group relative"><button type="button" title="很久以前" class="flex min-h-9 w-full items-center gap-2.5 rounded-[var(--radius-button)] px-3 text-left transition-colors text-[var(--text-muted)] hover:bg-[var(--surface-2)] hover:text-[var(--text)]" aria-pressed="false"><span aria-hidden="true" class="flex size-4 shrink-0 items-center justify-center rounded-[3px] border transition-colors border-[var(--border)] bg-transparent"></span><span class="min-w-0 flex-1 truncate text-[13px]">很久以前</span></button></li></ul></div></div>"`;

exports[`RecentsList states > shows a skeleton while loading, with the pending placeholder when a thread is starting 1`] = `"<div class="flex min-h-0 flex-1 flex-col overflow-y-auto px-3"><ul class="flex flex-col gap-1 px-3 py-3" aria-hidden="true"><li class="h-9 rounded-[var(--radius-button)] bg-[var(--surface-2)]"></li><li class="h-9 rounded-[var(--radius-button)] bg-[var(--surface-2)]"></li><li class="h-9 rounded-[var(--radius-button)] bg-[var(--surface-2)]"></li><li class="h-9 rounded-[var(--radius-button)] bg-[var(--surface-2)]"></li></ul></div>"`;

exports[`RecentsList states > shows a skeleton while loading, with the pending placeholder when a thread is starting 2`] = `"<div class="flex min-h-0 flex-1 flex-col overflow-y-auto px-3"><div class="pt-2 pb-1"><div role="status" aria-label="正在建立新對話…" class="mx-0 h-9 animate-pulse rounded-[var(--radius-button)] bg-[var(--surface-2)]"></div></div><ul class="flex flex-col gap-1 px-3 py-3" aria-hidden="true"><li class="h-9 rounded-[var(--radius-button)] bg-[var(--surface-2)]"></li><li class="h-9 rounded-[var(--radius-button)] bg-[var(--surface-2)]"></li><li class="h-9 rounded-[var(--radius-button)] bg-[var(--surface-2)]"></li><li class="h-9 rounded-[var(--radius-button)] bg-[var(--surface-2)]"></li></ul></div>"`;

exports[`RecentsList states > shows the empty line, with the placeholder when a thread is starting 1`] = `"<div class="flex min-h-0 flex-1 flex-col overflow-y-auto px-3"><p class="px-3 py-2 text-[13px] text-[var(--text-muted)]">尚無對話</p></div>"`;

exports[`RecentsList states > shows the error line, with the placeholder when a thread is starting 1`] = `"<div class="flex min-h-0 flex-1 flex-col overflow-y-auto px-3"><p class="px-3 py-2 text-[13px] text-[var(--text-muted)]">無法載入對話</p></div>"`;
