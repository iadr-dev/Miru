# ============================================================================
# backend/.env.example  —  template for backend/.env (which is GITIGNORED)
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# All secrets are KMS envelope-encrypted at rest in prod; here for local/dev.
# See docs/backend/modules/16-infrastructure.md §8 for the authoritative list.
# ============================================================================

# ---- Core app config ----
ENV=development                      # development | production
# INGEST_ON_STARTUP: dev-only startup catch-up ingest (§9c / ingest §6a).
# MUST be false in production (workers boot clean; leader scheduler owns ingest).
# Defaults to false in dev too — every `docker compose up`/`dev-backend.sh` restart otherwise
# auto-runs a multi-year backfill sweep, which can starve the api container's CPU/RAM on a
# shared dev host. Set to true to opt back into auto-catch-up, or seed explicitly via
# `dev-backend.sh --backfill`.
INGEST_ON_STARTUP=false
DEV_BACKFILL_YEARS=3                       # first-run dev backfill window (not full history)
WEBHOOK_BASE_URL=https://your-domain.example   # public base for OAuth/webhook callbacks
SCHEDULER_POLL_INTERVAL_SECONDS=60
INGEST_POLL_INTERVAL_SECONDS=60
# CORS_ALLOWED_ORIGINS=http://localhost:3000     # comma-separated; empty = no CORS middleware
# strict|compatibility|unsafe-explicit — never silently downgraded (sources/tls.py, governance).
TLS_POLICY=strict

# ---- Datastores ----
# App state: SQLite (dev) / Postgres (prod). Market data is NOT here (DuckDB/Parquet + Redis).
DATABASE_URL=sqlite+aiosqlite:///./dev.db      # prod: postgresql+asyncpg://user:pass@host/db
# Postgres pool + guard rails (ignored for SQLite): per-process pool, idle recycle, server-side statement cap
# SCHEMA_UPGRADE_MODE=strict              # strict: refuse a stale DB (reset it); additive: patch in place
# LOG_FORMAT=auto                        # auto (json in production) | json | console
# LOG_LEVEL=INFO
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=1800
# DB_STATEMENT_TIMEOUT_MS=30000        # 0 disables
# DB_POOL_TIMEOUT_SECONDS=10           # how long a request waits for a free connection
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000   # ends a session idle inside a transaction; 0 disables
# Only read by the Docker Compose stack (backend/docker-compose.yml) to set the compose Postgres
# service's password; DATABASE_URL above must then embed the same value. Falls back to a
# dev-only placeholder if unset — never used outside the local compose stack.
POSTGRES_PASSWORD=CHANGE_ME
DUCKDB_PATH=./data/duckdb                        # derived-store dir (leader writes Parquet here)
PARQUET_ROOT=./data/parquet
# Redis (cross-process SSE fan-out, cache, locks, quota counters). Upstash or self-hosted.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=CHANGE_ME
# REDIS_URL=redis://localhost:6379/0             # self-hosted alternative

# ---- Standalone MCP process (`python -m mcp`) ----
# A separate remote streamable-HTTP process from the main API — never wired into it.
MCP_HOST=0.0.0.0
MCP_PORT=8100
# comma-separated; empty = FastMCP's own safe defaults
MCP_ALLOWED_ORIGINS=
# comma-separated; empty = FastMCP's own safe defaults
MCP_ALLOWED_HOSTS=

# ---- Secrets encryption (prod) ----
# KMS_KEY_ID=arn:aws:kms:...                     # envelope encryption for user_secrets / BYOK

# ============================================================================
# LLM providers (provider-agnostic adapter — modules/04). Set the ones you use.
# Default provider/model chosen via config, not here. Anthropic is the default.
# ============================================================================
ANTHROPIC_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
GROQ_API_KEY=CHANGE_ME
CEREBRAS_API_KEY=CHANGE_ME
OPENROUTER_API_KEY=CHANGE_ME
# Local Ollama (no key; base URL + model name)
OLLAMA_BASE_URL=http://localhost:11434
# LLM_PROVIDER=anthropic                    # optional override
# LLM_MODEL=claude-...                       # optional override
# MODEL_ROLE_CLASSIFIER=groq/llama-3.3-70b-versatile   # per-role overrides; see llm/registry.py
# MODEL_ROLE_AGENT=anthropic/claude-sonnet-5
# MODEL_ROLE_SUBAGENT=anthropic/claude-sonnet-5
# MODEL_ROLE_SYNTHESIS=anthropic/claude-sonnet-5
CONTEXT_WINDOW_TOKENS=128000
CONTEXT_RESERVE_TOKENS=4000
AGENT_MAX_STEPS=8
LLM_MAX_OUTPUT_TOKENS=16000

# ---- Orchestrator per-turn budgets (orchestrator/ceilings.py) ----
ORCH_MAX_SUBAGENTS=4
ORCH_MAX_STEPS_PER_AGENT=8
ORCH_MAX_TOOL_CALLS_PER_TURN=40
ORCH_MAX_COST_MICROS_PER_TURN=5000000
ORCH_MAX_TOKENS_PER_TURN=1000000

# ============================================================================
# Data providers
# ============================================================================
# FinMind — the ONLY token-bearing market-data source. Ingest requires >= Backer
# (whole-market-by-date); Free tier is per-symbol only (won't power ingest).
FINMIND_API_KEY=CHANGE_ME
FINMIND_BASE_URL=https://api.finmindtrade.com/api/v4
# Web search fallback (Brave) — used when the active LLM has no native search
BRAVE_SEARCH_API_KEY=CHANGE_ME
# US / macro / analyst (router-registered, optional)
FINNHUB_KEY=CHANGE_ME
FINNHUB_WEBHOOK_SECRET=CHANGE_ME
ALPHA_VANTAGE_API_KEY=CHANGE_ME
FRED_KEY=CHANGE_ME
FMP_API_KEY=CHANGE_ME
# yfinance's tz cache — writable/persistent path.
YF_TZ_CACHE_DIR=./.cache/yf_tz

# ============================================================================
# OAuth sign-in (modules/12, adr/0022) — Google + LINE Login.
# LINE Login is a SEPARATE channel from LINE Messaging (below).
# redirect_uri points at THIS BACKEND's own /callback route (must match exactly what the
# provider console has on file); the callback then 302s the browser to FRONTEND_BASE_URL.
# ============================================================================
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://your-domain.example/api/v1/auth/oauth/google/callback

LINE_CHANNEL_ID=CHANGE_ME                  # LINE LOGIN channel
LINE_CHANNEL_SECRET=CHANGE_ME
LINE_REDIRECT_URI=https://your-domain.example/api/v1/auth/oauth/line/callback
# Log in with Telegram (OIDC): @BotFather -> your bot -> Login Widget -> add the redirect URI below
# to Allowed URLs; BotFather then shows the Client ID (defaults to the bot's id) and Client Secret.
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=CHANGE_ME
TELEGRAM_LOGIN_REDIRECT_URI=https://your-domain.example/api/v1/auth/oauth/telegram/callback

FRONTEND_BASE_URL=https://your-domain.example   # where the callback sends the browser after auth

# ---- JWT session (recommend ACCESS_TOKEN_EXPIRE ~15 min, not 1440) ----
JWT_SECRET_KEY=CHANGE_ME                   # generate a strong random secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# BYOK/channel-token envelope encryption — comma-separated Fernet keys (accounts/crypto.py).
SECRET_ENCRYPTION_KEYS=CHANGE_ME

# ============================================================================
# Notification delivery channels (modules/14) — NOT for sign-in.
# LINE Messaging API is a distinct channel from LINE Login above.
# ============================================================================
LINE_MESSAGING_CHANNEL_SECRET=CHANGE_ME
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=CHANGE_ME
LINE_BOT_BASIC_ID=@your_bot
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_USERNAME=your_bot
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
# Email via Resend (https://resend.com). The from-address must use a domain verified there.
RESEND_API_KEY=CHANGE_ME
# Shown when you add the webhook (<WEBHOOK_BASE_URL>/api/v1/webhooks/resend) in Resend → Webhooks.
RESEND_WEBHOOK_SECRET=whsec_CHANGE_ME
EMAIL_FROM_ADDRESS=alerts@your-domain.example
APNS_KEY_ID=CHANGE_ME
APNS_TEAM_ID=CHANGE_ME
APNS_BUNDLE_ID=CHANGE_ME
APNS_AUTH_KEY=CHANGE_ME
FCM_PROJECT_ID=CHANGE_ME
FCM_SERVICE_ACCOUNT_JSON=CHANGE_ME

# ============================================================================
# Payments — Paddle (modules/15). MoR; webhook is the entitlement source of truth.
# 8 price IDs = {premium,pro} × {monthly,annual} × {standard,BYOK}.
# ============================================================================
PADDLE_API_KEY=CHANGE_ME
PADDLE_ENVIRONMENT=sandbox                 # sandbox | production
PADDLE_WEBHOOK_SECRET=CHANGE_ME
PADDLE_CLIENT_TOKEN=CHANGE_ME              # publishable Paddle.js token (safe to expose)
PADDLE_PRICE_PREMIUM_MONTHLY=pri_CHANGE_ME
PADDLE_PRICE_PREMIUM_ANNUAL=pri_CHANGE_ME
PADDLE_PRICE_PREMIUM_BYOK_MONTHLY=pri_CHANGE_ME
PADDLE_PRICE_PREMIUM_BYOK_ANNUAL=pri_CHANGE_ME
PADDLE_PRICE_PRO_MONTHLY=pri_CHANGE_ME
PADDLE_PRICE_PRO_ANNUAL=pri_CHANGE_ME
PADDLE_PRICE_PRO_BYOK_MONTHLY=pri_CHANGE_ME
PADDLE_PRICE_PRO_BYOK_ANNUAL=pri_CHANGE_ME

# ============================================================================
# Redis-backed transport / rate-limiting / caching (module 16 §3/§4) — "memory" backends are the
# non-network default; the dev-parity docker-compose stack forces these to "redis".
# ============================================================================
# EVENT_BUS_BACKEND=memory                  # memory | redis
# RATE_LIMITER_BACKEND=memory                # memory | redis
# TRUSTED_PROXY_COUNT=0                     # reverse proxies of your own in front of the API (reads X-Forwarded-For from the right)
RATE_LIMIT_KEY_PREFIX=ratelimit
DATA_UPDATED_KEY_PREFIX=data.updated

# FinMind Sponsor-pool quota (usage/finmind_pool.py)
FINMIND_POOL_KEY_PREFIX=finmind:pool
FINMIND_POOL_LIMIT_PER_WINDOW=6000
FINMIND_POOL_WINDOW_SECONDS=3600
FINMIND_RESERVE_PER_LANE=1

# Live-quote streaming (events/live_quote_factory.py)
QUOTE_POLL_CADENCE_NORMAL_SECONDS=5
QUOTE_POLL_CADENCE_SAVER_SECONDS=20
QUOTE_STREAM_MAX_SYMBOLS_PER_CONNECTION=50
QUOTE_STREAM_MAX_DEMANDED_SYMBOLS=500
QUOTE_CHANNEL_KEY_PREFIX=quote
QUOTE_DEMAND_KEY_PREFIX=demand

# Market-data read-through cache (sources/caching_adapter.py, dataaccess/composition.py)
# MARKET_DATA_CACHE_BACKEND=none            # none | redis
MARKET_DATA_CACHE_KEY_PREFIX=mdcache
MARKET_DATA_CACHE_TTL_REFERENCE_SECONDS=86400
MARKET_DATA_CACHE_TTL_LIVE_ISH_SECONDS=15
MARKET_DATA_CACHE_TTL_OFFICIAL_EOD_SECONDS=3600
MARKET_DATA_CACHE_TTL_EVENT_DRIVEN_SECONDS=300

# ============================================================================
# Voice (voice/providers.py, api/routers/voice.py) — "stub" is the deterministic non-network
# default; real providers are opt-in.
# ============================================================================
VOICE_STT_PROVIDER=stub                    # stub | faster_whisper
VOICE_TTS_PROVIDER=stub                    # stub | edge_tts | openai

# ---- Chat attachments (attachments/, api/attachments.py) ----
MAX_ATTACHMENT_SIZE_BYTES=10000000

# ---- Browser notifications (Web Push / VAPID) ----
# Generate once:  uv run python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); ..."
# (see docs/backend/modules/14-scheduler-alerts.md §6). The public key is shown to browsers.
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:you@example.com
