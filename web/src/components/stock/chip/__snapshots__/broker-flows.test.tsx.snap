// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ChipFlowsBody data > shows the stats, ratios against the latest shares issued, and the buy table 1`] = `"<div><div class="mb-3 flex flex-wrap gap-1 rounded-[var(--radius-pill)] bg-[var(--surface-2)] p-0.5"><button type="button" aria-pressed="true" class="rounded-[var(--radius-pill)] font-medium text-[12px] transition-colors px-2.5 py-1 bg-[var(--accent-weak)] text-[var(--accent-text)]">近日</button><button type="button" aria-pressed="false" class="rounded-[var(--radius-pill)] font-medium text-[12px] transition-colors px-2.5 py-1 text-[var(--text-muted)] hover:text-[var(--text)]">5日</button><button type="button" aria-pressed="false" class="rounded-[var(--radius-pill)] font-medium text-[12px] transition-colors px-2.5 py-1 text-[var(--text-muted)] hover:text-[var(--text)]">10日</button></div><div class="mb-4 grid grid-cols-2 gap-3 font-num text-[13px] tabular-nums"><div><p class="text-[11px] text-[var(--text-muted)]">主力進出</p><p class="font-num tabular-nums" style="color: var(--up);">▲ 1,000 張</p></div><div><p class="text-[11px] text-[var(--text-muted)]">主力集中%</p><p class="font-num tabular-nums">25.00%</p></div><div><p class="text-[11px] text-[var(--text-muted)]">佔股本比重</p><p class="font-num tabular-nums">0.00%</p></div><div><p class="text-[11px] text-[var(--text-muted)]">集中天數%</p><p class="font-num tabular-nums">60%</p></div><div><p class="text-[11px] text-[var(--text-muted)]">成交量(張)</p><p class="font-num tabular-nums">4,000 張</p></div><div><p class="text-[11px] text-[var(--text-muted)]">區間周轉率(%)</p><p class="font-num tabular-nums">0.02%</p></div></div><div class="mb-2 flex items-center justify-between"><div class="mb-3 flex flex-wrap gap-1 rounded-[var(--radius-pill)] bg-[var(--surface-2)] p-0.5"><button type="button" aria-pressed="true" class="rounded-[var(--radius-pill)] font-medium text-[12px] transition-colors px-2.5 py-1 bg-[var(--accent-weak)] text-[var(--accent-text)]">買超Top15</button><button type="button" aria-pressed="false" class="rounded-[var(--radius-pill)] font-medium text-[12px] transition-colors px-2.5 py-1 text-[var(--text-muted)] hover:text-[var(--text)]">賣超Top15</button></div><span class="text-[11px] text-[var(--text-muted)]">~ 2026-10-16</span></div><div><h4 class="mb-2 font-medium text-[13px] text-[var(--text)]">買超Top15</h4><div class="overflow-x-auto"><table class="w-full text-[12px]"><thead><tr class="border-[var(--border)] border-b text-[var(--text-muted)]"><th class="py-1.5 text-left font-medium">券商分點</th><th class="py-1.5 text-right font-medium">買賣超</th><th class="py-1.5 text-right font-medium">買張</th><th class="py-1.5 text-right font-medium">賣張</th><th class="py-1.5 text-right font-medium">成交比重</th></tr></thead><tbody><tr class="border-[var(--border)] border-b"><td class="py-1.5 text-[var(--text)]">券商1</td><td class="py-1.5 text-right font-num tabular-nums" style="color: var(--up);">▲ 99 張</td><td class="py-1.5 text-right font-num text-[var(--text)] tabular-nums">150 張</td><td class="py-1.5 text-right font-num text-[var(--text)] tabular-nums">50 張</td><td class="py-1.5 text-right font-num text-[var(--text)] tabular-nums">5.00%</td></tr><tr class="border-[var(--border)] border-b"><td class="py-1.5 text-[var(--text)]">券商2</td><td class="py-1.5 text-right font-num tabular-nums" style="color: var(--up);">▲ 98 張</td><td class="py-1.5 text-right font-num text-[var(--text)] tabular-nums">150 張</td><td class="py-1.5 text-right font-num text-[var(--text)] tabular-nums">50 張</td><td class="py-1.5 text-right font-num text-[var(--text)] tabular-nums">5.00%</td></tr></tbody></table></div></div></div>"`;

exports[`ChipFlowsBody states > shows a skeleton while loading 1`] = `"<div aria-hidden="true" class="flex flex-col gap-3" style="height: 440px;"><div aria-hidden="true" class="skeleton rounded-[var(--radius-input)] h-4 w-1/3 shrink-0"></div><div aria-hidden="true" class="skeleton rounded-[var(--radius-input)] min-h-0 flex-1"></div></div>"`;

exports[`ChipFlowsBody states > shows the Sponsor teaser when the data is masked 1`] = `"<div class="relative w-full overflow-hidden rounded-[var(--radius-card)]"><p class="mb-2 font-medium text-[14px] text-[var(--text)]">分點</p><div aria-hidden="true" class="pointer-events-none blur-[6px]"><div class="h-48 rounded-[var(--radius-input)] bg-[var(--surface-2)]"></div></div><div class="glass absolute inset-0 top-7 flex flex-col items-center justify-center gap-3 rounded-[var(--radius-card)] border border-[var(--border)] bg-[var(--surface)]/70 px-6 py-8 text-center" style="background-image: repeating-linear-gradient(135deg, color-mix(in srgb, var(--border) 40%, transparent) 0px, color-mix(in srgb, var(--border) 40%, transparent) 1px, transparent 1px, transparent 12px);"><span class="grid size-11 place-items-center rounded-[var(--radius-pill)] bg-[var(--surface-2)]"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="text-[var(--text-muted)]"><path d="M208,80H176V56a48,48,0,0,0-96,0V80H48A16,16,0,0,0,32,96V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V96A16,16,0,0,0,208,80ZM96,56a32,32,0,0,1,64,0V80H96ZM208,208H48V96H208V208Zm-68-56a12,12,0,1,1-12-12A12,12,0,0,1,140,152Z"></path></svg></span><p class="max-w-xs text-[13px] text-[var(--text-muted)] leading-relaxed">預覽文字</p><a aria-label="解鎖看完整資料（Pro）" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-[var(--radius-button)] px-5 bg-[var(--accent)] font-medium text-[15px] text-[var(--bg)] transition-colors duration-150 hover:opacity-90 active:scale-[0.98]" href="/zh-TW/settings/billing">解鎖看完整資料（Pro）</a></div></div>"`;

exports[`ChipFlowsBody top table > colours a net by direction and prefixes its glyph 1`] = `
[
  "var(--up)",
  "var(--down)",
  "var(--text-muted)",
]
`;

