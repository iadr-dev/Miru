ass="font-medium text-[var(--text)]">預覽：</span>填寫完成後會在這裡顯示提醒條件。</p><div class="flex justify-end gap-2"><button type="button" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-transparent text-[var(--text)] hover:bg-[var(--surface-2)] min-h-11 px-4 text-sm">取消</button><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-[var(--accent)] text-[var(--on-accent)] hover:opacity-90 font-medium min-h-11 px-4 text-sm">建立提醒</button></div></form>"`;

exports[`AlertForm validation and switching > submitting an empty symbol rule shows the required errors 1`] = `"<form aria-label="新增提醒" class="space-y-4 rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface-2)] p-4"><fieldset class="grid gap-3 sm:grid-cols-2"><div class="sm:col-span-2"><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="alert-scope">適用範圍</label><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="alert-scope"><option value="symbol">單一標的</option><option value="watchlist">自選股群組（相對條件）</option><option value="perStock">逐檔設定價位</option></select></div><div><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="alert-symbol">股票代號</label><input class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] placeholder:text-[var(--text-muted)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="alert-symbol" placeholder="2330" value=""><p role="alert" class="mt-1 text-[12px] text-[var(--warn)]">請輸入股票代號。</p></div><div><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="alert-market">市場</label><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="alert-market"><option value="TW">台股</option><option value="US">美股</option></select></div><div class="sm:col-span-2"><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="alert-template">提醒類型</label><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="alert-template"><option value="close_price">收盤價</option><option value="daily_change">單日漲跌幅</option><option value="volume_surge">成交量放大</option><option value="institutional_streak">法人連續買賣超</option><option value="attention_entry">列入注意股</option><option value="disposition_entry">列入處置股</option><option value="month_revenue_published">公布月營收</option><option value="material_announcement">公司公布重大訊息</option><option value="margin_balance_change">融資融券餘額變動</option><option value="etf_premium_discount">ETF 折溢價</option></select></div><div><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="alert-comparator">條件</label><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="alert-comparator"><option value="above">高於</option><option value="below">低於</option></select></div><div><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="alert-value">價位</label><input class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] placeholder:text-[var(--text-muted)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="alert-value" inputmode="decimal" step="any" type="number" value="" aria-invalid="true"><p role="alert" class="mt-1 text-[12px] text-[var(--warn)]">請輸入數值。</p></div><div class="sm:col-span-2"><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="alert-trigger-mode">通知頻率</label><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="alert-trigger-mode"><option value="once">只通知一次</option><option value="once_per_day">條件成立時通知（成立後需先解除才會再通知）</option><option value="every_occurrence">每次資料更新且條件成立都通知</option></select></div><div><label class="mb-1 block text-[13px] text-[var(--text-muted)]" for="alert-expiry">有效期</label><select class="min-h-11 w-full rounded-[var(--radius-input)] border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] text-[var(--text)] !outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]" id="alert-expiry"><option value="30">30 天</option><option value="90">90 天</option><option value="365">1 年</option><option value="never">不會過期</option></select></div></fieldset><p class="text-[13px] text-[var(--text-muted)]" aria-live="polite"><span class="font-medium text-[var(--text)]">預覽：</span>填寫完成後會在這裡顯示提醒條件。</p><div class="flex justify-end gap-2"><button type="button" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-transparent text-[var(--text)] hover:bg-[var(--surface-2)] min-h-11 px-4 text-sm">取消</button><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] transition-colors duration-150 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 bg-[var(--accent)] text-[var(--on-accent)] hover:opacity-90 font-medium min-h-11 px-4 text-sm">建立提醒</button></div></form>"`;
