// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SnapshotCard empty and unavailable results > shows the server's message when the result was not found 1`] = `"<p class="surface-card mt-3 p-4 text-[13px] text-[var(--text-muted)]">尚未計算評分</p>"`;

exports[`SnapshotCard entity unwrapping > reads a top-level entity when there is no wrapper 1`] = `"<div class="surface-card mt-3 p-4 sm:p-5"><div class="mb-3 flex items-baseline justify-between gap-3"><span class="font-medium text-[13px] text-[var(--text-muted)]">2330</span><span class="text-[11px] text-[var(--text-muted)]">公司概況</span></div><div class="grid grid-cols-2 gap-3 sm:grid-cols-3"><div class="min-w-0"><p class="truncate text-[11px] text-[var(--text-muted)]">Employees</p><p class="font-num text-[14px] text-[var(--text)] tabular-nums">1,234</p></div></div></div>"`;

