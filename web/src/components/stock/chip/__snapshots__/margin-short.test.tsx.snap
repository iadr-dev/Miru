exports[`MarginShortBody day trading > converts shares to lots and shows the money amounts as they are 1`] = `"<table class="w-full text-[13px]"><thead><tr class="border-[var(--border)] border-b text-[11px] text-[var(--text-muted)]"><th class="px-2 py-1.5 text-right font-medium first:text-left">日期</th><th class="px-2 py-1.5 text-right font-medium first:text-left">當沖總和</th><th class="px-2 py-1.5 text-right font-medium first:text-left">當沖買進金額</th><th class="px-2 py-1.5 text-right font-medium first:text-left">當沖賣出金額</th></tr></thead><tbody class="divide-y divide-[var(--border)]"><tr><td class="px-2 py-1.5 font-num text-[var(--text)] tabular-nums">2026-01-03</td><td class="px-2 py-1.5 text-right font-num text-[var(--text)] tabular-nums">2,500 張</td><td class="px-2 py-1.5 text-right font-num text-[var(--text)] tabular-nums">1,234,567</td><td class="px-2 py-1.5 text-right font-num text-[var(--text)] tabular-nums">2,345,678</td></tr><tr><td class="px-2 py-1.5 font-num text-[var(--text)] tabular-nums">2026-01-02</td><td class="px-2 py-1.5 text-right font-num text-[var(--text)] tabular-nums">1,000 張</td><td class="px-2 py-1.5 text-right font-num text-[var(--text)] tabular-nums">1,234,567</td><td class="px-2 py-1.5 text-right font-num text-[var(--text)] tabular-nums">2,345,678</td></tr></tbody></table>"`;

