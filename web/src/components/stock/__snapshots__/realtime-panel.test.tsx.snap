// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RealtimeTab 詳細 stats > shows the limit pills, the live figures and the tick-derived figures 1`] = `"<h2 class="mb-2 font-semibold text-[15px] text-[var(--text)]">詳細</h2><div class="grid grid-cols-3 gap-3 text-[13px]"><div><p class="mb-1 text-[11px] text-[var(--text-muted)]">跌停</p><p class="inline-block rounded-[var(--radius-pill)] px-2.5 py-1 font-num font-semibold text-[14px] text-[var(--surface)] tabular-nums" style="background-color: var(--down);">90.00</p></div><div><p class="mb-1 text-[11px] text-[var(--text-muted)]">漲停</p><p class="inline-block rounded-[var(--radius-pill)] px-2.5 py-1 font-num font-semibold text-[14px] text-[var(--surface)] tabular-nums" style="background-color: var(--up);">110.00</p></div><div><p class="mb-1 text-[11px] text-[var(--text-muted)]">參考</p><p class="inline-block rounded-[var(--radius-pill)] px-2.5 py-1 font-num font-semibold text-[14px] text-[var(--surface)] tabular-nums" style="background-color: var(--warn);">100.00</p></div></div><div class="mt-3 grid grid-cols-3 gap-3 text-[13px]"><div><p class="text-[11px] text-[var(--text-muted)]">成交</p><p class="font-num text-[15px] text-[var(--text)] tabular-nums">103.00</p></div><div><p class="text-[11px] text-[var(--text-muted)]">漲跌</p><p role="group" aria-label="漲跌 上漲 3.00 (3.00%)" class="font-num text-[15px] tabular-nums" style="color: var(--up);"><span aria-hidden="true">▲3.00 (3.00%)</span></p></div><div><p class="text-[11px] text-[var(--text-muted)]">振幅</p><p class="font-num text-[15px] text-[var(--text)] tabular-nums">7.00%</p></div><div><p class="text-[11px] text-[var(--text-muted)]">最低</p><p class="font-num text-[15px] text-[var(--text)] tabular-nums">98.00</p></div><div><p class="text-[11px] text-[var(--text-muted)]">最高</p><p class="font-num text-[15px] text-[var(--text)] tabular-nums">105.00</p></div><div><p class="text-[11px] text-[var(--text-muted)]">總量</p><p class="font-num text-[15px] text-[var(--text)] tabular-nums">12,345</p></div><div><p class="text-[11px] text-[var(--text-muted)]">內盤</p><p class="font-num text-[15px] text-[var(--text)] tabular-nums">30</p></div><div><p class="text-[11px] text-[var(--text-muted)]">外盤</p><p class="font-num text-[15px] text-[var(--text)] tabular-nums">10</p></div><div><p class="text-[11px] text-[var(--text-muted)]">單量</p><p class="font-num text-[15px] text-[var(--text)] tabular-nums">60</p></div><div><p class="text-[11px] text-[var(--text-muted)]">均價</p><p class="font-num text-[15px] text-[var(--text)] tabular-nums">99.80</p></div></div><p class="mt-2 text-[11px] text-[var(--text-muted)]">資料日期：2026-10-16</p>"`;
